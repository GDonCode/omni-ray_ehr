            <div className="flex flex-col rounded-lg overflow-hidden w-[90%] mx-auto mt-4 shadow-md hover:shadow-lg">
              <video src={"/cleaning-vid.mp4"} autoPlay muted loop></video>
              <div className="bg-[#eef3f9] p-4 rounded-b-lg ">
                <h3 className={`${noticia_regular.className} flex items-center text-2xl font-semibold tracking-wide mb-3`}>
